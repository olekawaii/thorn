include
    graphical_options
    dragon
    chess
    sleeping_cat
    squish
    drawings

let main the list frame dragon palette_default

--  If you want to pick the options for th2gif, uncomment

--  let main the
--      with_graphics list frame                -- type
--      with_graphics
--          graphical_options
--              unifont                         -- font
--              gruvbox_material_dark_hard      -- theme
--              fps v                           -- fps
--          dragon palette_default              -- video

--  A note about main's return type; main's type can be
--  whatever you want, but if you want it to be
--  interpretable by th2sh/th2gif it must be a type
--  they know. Here's a type representing the known types
--
--      type valid_video_type contains
--          frame
--          (list frame)
--          video
--          with_graphics   valid_video_type

let make_monochrome the fn list frame list frame entirely dye white

