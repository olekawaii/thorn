include video

let main be the list frame dragon default_dragon_p

type dragon_p contains                      -- the dragon's color palette
    dragon_p color color color              -- skin, eye, wing

let default_dragon_p be the dragon_p dragon_p cyan yellow green

let center_head be the fn dragon_p list frame lambda dragon_p s e _ art xii ix
