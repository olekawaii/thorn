include combinators

type bool contains
    true
    false

--  Unlike other languages, if/then/else aren't
--  built into the language. You either have to
--  pattern match or use this if function for
--  one-liners.

forall a let if the 
    fn bool fn a fn a a
    lambda condition lambda then lambda else match condition
        case true       then
        case false      else

let not the fn bool bool lambda x match x
    case true           false
    case false          true

let or the fn bool fn bool bool 
    lambda x match x 
        case true       const true
        case false      identity

let and the fn bool fn bool bool 
    lambda x match x
        case false      const false
        case true       identity

let xor  the 
    fn bool fn bool bool 
    lambda a lambda b not xand a b

let xand the fn bool fn bool bool eq_bool

let nor  the 
    fn bool fn bool bool 
    lambda a lambda b not or a b
    
let nand the 
    fn bool fn bool bool 
    lambda a lambda b not and a b

let eq_bool the fn bool fn bool bool lambda x match x
    case true           identity
    case false          not
