let right_half be the fn dragon_p list frame
    lambda bind p dragon_p s _ _ layer
        layer
            entirely shift_by pos vi pos vii layer
                cycle cat
                    loop extend blow p
                    loop entirely by ii shift south roar p
                cycle for iii rotate_right entirely by xv shift east fire
            cycle entirely
                shift_by pos xi pos i
                append new_frame dragon_wing p
        layer
            cycle slow ii entirely shift_by pos iv neg i dragon_foot p
            cycle for ii rotate for ii extend art x vii
