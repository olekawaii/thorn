include ordering binary_tree option

--  The data constructor is unsafe because the 
--  type has multiple invariants:
--  
--  * The tree must stay sorted
--  * the sorting is determined by the ordering
--    function

forall a b type ordered_map contains
    unsafe_ordered_map
        fn a fn a ordering     -- Ordering function
        tree tuple a b         -- Internal sorted binary tree

--  Create a new empty map with a given ordering 
--  function

forall a b let new_ordered_map be the 
    fn fn a fn a ordering ordered_map a b
    lambda f unsafe_ordered_map f empty

--  Get the value associated with the give key. 
--  Returns an optional value

forall a b let get_ord be the 
    fn a fn ordered_map a b option b
    lambda key lambda unsafe_ordered_map f tree match tree
        case empty                  none
        case node tuple k v l r     match f key k 
            case eq     some v
            case lt     get_ord key unsafe_ordered_map f l
            case gt     get_ord key unsafe_ordered_map f r

--  Insert a key/value pair into a map

forall a b let insert_ord be the 
    fn a fn b fn ordered_map a b ordered_map a b
    lambda key lambda value lambda map
        unsafe_apply_to_ordered_map_pair 
            key
            lambda x match x
                case empty              node tuple key value empty empty
                case node _ l r         node tuple key value l r
            map

--  Remove a key from a map

forall a b let remove_ord be the 
    fn a fn ordered_map a b ordered_map a b
    lambda key lambda map
        unsafe_apply_to_ordered_map_pair 
            key
            lambda x match x
                case empty              empty
                case node _ l r         attach_to_leftmost l r
            map

forall a b let unsafe_apply_to_ordered_map_pair be the
    fn a fn
        fn tree tuple a b tree tuple a b
        fn ordered_map a b ordered_map a b
    lambda k lambda f lambda unsafe_ordered_map o t
        unsafe_ordered_map o unsafe_apply_to_ordered_map_pair_helper k f o t

forall a b let unsafe_apply_to_ordered_map_pair_helper be the 
    fn a fn
        fn tree tuple a b tree tuple a b
        fn
            fn a fn a ordering 
            fn tree tuple a b tree tuple a b
    lambda key lambda ff lambda f lambda tree match tree
        case empty              ff empty
        case 
            node bind root tuple k _ left right    
            match f key k 
                case eq                 ff tree
                case lt                 node 
                    root
                    unsafe_apply_to_ordered_map_pair_helper key ff f left
                    right
                case gt                 node 
                    root
                    left
                    unsafe_apply_to_ordered_map_pair_helper key ff f right
