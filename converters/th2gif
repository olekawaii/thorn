#!/bin/sh

set -eu
FONT_DIR="$HOME/.local/share/thorn/fonts/"
FPS=5

print_help() {
    printf 'th2gif options:
        --font-dir DIR       Set the font directory to DIR
        --fps FPS            Set the fps to FPS
        --help               Show this help message
    ' >&2
    exit 0
}

while [ $# != 0 ]; do
    case "$1" in 
        --font-dir)
            FONT_DIR="$2"
            shift
            ;;
        --fps)
            FPS="$2"
            shift
            ;;
        --help | -h)
            print_help
            ;;
        *)
            printf "\33[91merror: \33[0munknown option '%s'\n" "$1"  >&2
            printf 'use --help to see all options\n'                 >&2
            exit 1
            ;;
    esac
    shift
done

printf "    \033[95mfont-dir   \033[0m$FONT_DIR\n" >&2
printf "    \033[95mfps        \033[0m$FPS\n"      >&2

temp="/tmp/thorn-to-gif"
rm -r $temp > /dev/null 2>&1 || true
mkdir $temp
cd $temp
th2ppm --font-dir $FONT_DIR

ffmpeg                                 \
    -loglevel error                    \
    -i output%05d.ppm                  \
    -vf palettegen=max_colors=8 palette.png

ffmpeg                                 \
    -loglevel error                    \
    -framerate $FPS                    \
    -i output%05d.ppm                  \
    -i palette.png                     \
    -lavfi "paletteuse=dither=none"    \
    -f gif                             \
    -

cd -
rm -r $temp

